{
  "name": "hokmob",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node dev.js",
    "prestart": "node aspnetcore-https",
    "start": "run-script-os",
    "start:windows": "ng serve --port 44424 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:default": "ng serve --port 44424 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "clean-cache": "ng cache clean",
    "capture-live-fixtures": "node capture-live-fixtures.js",
    "build-season-data": "node build-season-data.js",
    "build-nst-team-games": "node build-nst-team-games.js",
    "build-play-by-play": "node build-play-by-play.js",
    "build-edge-data": "node build-edge-data.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "chart.js": "^4.2.1",
    "dayjs": "^1.11.7",
    "jquery": "^3.6.0",
    "node": "^24.22.3",
    "run-script-os": "^1.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/jasmine": "~4.3.0",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "^18.7.11",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  }
}