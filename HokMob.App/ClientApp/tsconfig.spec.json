/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // The nhl-api-mocks fixtures are imported as JSON
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    // Don't add "node": it clashes with the DOM lib and changes setInterval's return type
    "types": [
      "jasmine"
    ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
